+// roamarr-de: German DISPLAY names for navigation labels.
+// The English labels stay the data keys (expand state, {#each} keys, `section.label === 'Plan'`),
+// so only the rendering looks names up here. Unknown labels fall back to English.
+const NAV_DE: Record<string, string> = {
+	// sections
+	Plan: 'Planen',
+	Me: 'Persönlich',
+	Organizer: 'Organisieren',
+	Admin: 'Administration',
+	// items
+	Dashboard: 'Übersicht',
+	Trips: 'Reisen',
+	Places: 'Orte',
+	Notifications: 'Benachrichtigungen',
+	Profile: 'Profil',
+	Account: 'Konto',
+	'Emergency Contacts': 'Notfallkontakte',
+	'Email Settings': 'E-Mail-Einstellungen',
+	'MCP Clients': 'MCP-Clients',
+	'API Keys': 'API-Schlüssel',
+	Security: 'Sicherheit',
+	Documents: 'Dokumente',
+	Reminders: 'Erinnerungen',
+	Loyalty: 'Bonusprogramme',
+	Visited: 'Besucht',
+	Countries: 'Länder',
+	'U.S. States': 'US-Bundesstaaten',
+	Cards: 'Zahlungskarten',
+	Insurance: 'Versicherungen',
+	Groups: 'Gruppen',
+	Configuration: 'Konfiguration',
+	General: 'Allgemein',
+	Maps: 'Karten',
+	Email: 'E-Mail',
+	Webhooks: 'Webhooks',
+	Users: 'Benutzer',
+	'Fare providers': 'Preisanbieter',
+	Maintenance: 'Wartung',
+	'Database Maintenance': 'Datenbankwartung',
+	'Job History': 'Jobverlauf',
+	'Audit Logs': 'Audit-Logs',
+	'Backup & Restore': 'Backup & Wiederherstellen',
+	'Seed Demo Data': 'Demodaten einspielen',
+	// profile tabs
+	Sessions: 'Sitzungen',
+	Calendar: 'Kalender',
+	Theme: 'Design'
+};
+
+export const navLabel = (label: string): string => NAV_DE[label] ?? label;
