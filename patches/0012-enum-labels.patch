new file mode 100644
index 0000000..b759c82
--- /dev/null
+++ b/src/lib/enumDe.ts
@@ -0,0 +1,14 @@
+// roamarr-de: German display names for stored enum keys (keys themselves stay unchanged).
+const MAPS = {
+	visibility: { private: 'Privat', groups: 'Gruppen', public: 'Öffentlich' },
+	documentType: { passport: 'Reisepass', drivers_license: 'Führerschein', global_entry: 'Global Entry', visa: 'Visum' },
+	companion: { adult: 'Erwachsener', child: 'Kind', other: 'Sonstige', guide: 'Reiseführer', driver: 'Fahrer' },
+	expense: { lodging: 'Unterkunft', transport: 'Transport', food: 'Essen', activities: 'Aktivitäten', other: 'Sonstiges' },
+	attendee: { going: 'Dabei', maybe: 'Vielleicht', not_going: 'Nicht dabei' },
+	reminder: { pending: 'Ausstehend', sending: 'Wird gesendet', sent: 'Gesendet' }
+} as const satisfies Record<string, Record<string, string>>;
+
+export function deEnum(kind: keyof typeof MAPS, value: unknown): string {
+	const key = String(value ?? '');
+	return (MAPS[kind] as Record<string, string>)[key] ?? key.replaceAll('_', ' ');
+}
